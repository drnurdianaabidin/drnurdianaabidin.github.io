---
// Media contributions and public engagement: newspaper articles, interviews,
// expert commentary, public talks and other science communication from the
// Community section, grouped by type. Each piece is listed once, with every
// outlet that published it.
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import T from '../components/T.astro';
import Illustration from '../components/Illustration.astro';
import { plain } from '../lib/placeholder.mjs';
import { settings, getMedia, itemUrl, formatDate, isoDate, sortedAppearances, MEDIA_TYPES } from '../lib/items';

const media = await getMedia();
const groups = MEDIA_TYPES.map((type) => ({
  type,
  id: type.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  items: media.filter((item) => item.data.type === type),
})).filter((g) => g.items.length > 0);
---

<Base
  title="Media Contributions & Public Engagement"
  description={`Newspaper articles, expert commentary and public science communication by ${settings.name} on sarcopenia, body composition, muscle health and healthy ageing.`}
>
  <Masthead slot="header" current="media" />

  <header class="media-hero">
    <div class="wrap media-hero__inner">
      <div class="reveal">
        <p class="label">Public engagement</p>
        <h1 class="media-hero__title">Media Contributions &amp; Public Engagement</h1>
        <p class="media-hero__desc">
          Writing and commentary for the public on muscle health, body composition and healthy ageing.
        </p>
        <p class="media-hero__note">
          These pieces are written for a general readership. They are not peer-reviewed and are not counted
          under{' '}<a href="/publications/">Publications</a>.
        </p>
      </div>
      <div class="media-hero__media reveal reveal--right">
        <Illustration name="community" alt="" />
      </div>
    </div>
  </header>

  <div class="wrap media">
    {
      groups.map((group) => (
        <section class="media__group" aria-labelledby={group.id}>
          <h2 id={group.id} class="media__heading reveal">
            {group.type}
            <span class="media__count">{group.items.length}</span>
          </h2>
          <ol class="media__list">
            {group.items.map((item, i) => {
              const appearances = sortedAppearances(item);
              return (
                <li class="card card--link media-card reveal" style={`--delay:${Math.min(i, 4) * 70}ms`}>
                  <div class="media-card__main">
                    <h3 class="media-card__title">
                      <a href={itemUrl(item)}>
                        <T text={item.data.title} />
                      </a>
                    </h3>
                    <p class="media-card__summary">
                      <T text={item.data.summary} />
                    </p>
                  </div>
                  {appearances.length > 0 && (
                    <div class="media-card__where">
                      <p class="label label--muted">
                        {appearances.length > 1 ? `Published in ${appearances.length} outlets` : 'Published in'}
                      </p>
                      <ul class="media-card__outlets">
                        {appearances.map((a) => (
                          <li>
                            {a.url ? (
                              <a class="outlet" href={a.url} rel="noopener">
                                <span class="outlet__name">
                                  <T text={a.outlet} />
                                </span>
                                {a.date && (
                                  <time class="outlet__date" datetime={isoDate(a.date)}>
                                    {formatDate(a.date)}
                                  </time>
                                )}
                                <span class="outlet__arrow" aria-hidden="true">
                                  ↗
                                </span>
                                <span class="visually-hidden">: {plain(item.data.title)}</span>
                              </a>
                            ) : (
                              <span class="outlet">
                                <span class="outlet__name">
                                  <T text={a.outlet} />
                                </span>
                                {a.date && (
                                  <time class="outlet__date" datetime={isoDate(a.date)}>
                                    {formatDate(a.date)}
                                  </time>
                                )}
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }

    <p class="media__more reveal">
      Requests for interviews or expert comment are welcome by <a href="/contact/">email</a>. Community programmes and outreach are listed
      under{' '}<a href="/community/">Community</a>.
    </p>
  </div>
</Base>

<style>
  .media-hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(800px 300px at 90% 0%, var(--teal-soft), transparent 70%),
      radial-gradient(700px 300px at 0% 100%, var(--violet-soft), transparent 70%);
    border-bottom: 1px solid var(--rule);
  }

  .media-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .media-hero__title {
    font-size: clamp(2.4rem, 4.2vw + 0.5rem, 4.2rem);
    font-weight: 500;
    line-height: 1.06;
    max-width: 16ch;
    margin: 0.6rem 0 1rem;
  }

  .media-hero__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1vw + 1rem, 1.55rem);
    line-height: 1.4;
    max-width: 36ch;
    color: var(--ink-soft);
  }

  .media-hero__note {
    margin: 0;
    max-width: 44ch;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .media-hero__media {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .media {
    max-width: 62rem;
    padding-top: var(--space-6);
  }

  .media__group + .media__group {
    margin-top: var(--space-6);
  }

  .media__heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.7rem, 1.5vw + 1.2rem, 2.3rem);
    margin: 0 0 var(--space-4);
  }

  .media__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.9rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--teal-soft);
    color: var(--brass-text);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .media__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .media-card {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .media-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(var(--brass), var(--violet));
    opacity: 0;
    transition: opacity var(--medium) var(--ease);
  }

  .media-card:hover::before,
  .media-card:focus-within::before {
    opacity: 1;
  }

  .media-card__title {
    font-size: clamp(1.35rem, 0.8vw + 1.15rem, 1.7rem);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }

  .media-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .media-card__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--brass);
  }

  .media-card__summary {
    margin: 0;
    color: var(--ink-soft);
  }

  .media-card__where {
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 1px solid var(--rule);
  }

  .media-card__where .label {
    margin: 0 0 0.6rem;
  }

  .media-card__outlets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .outlet {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      border-color var(--quick) var(--ease),
      background-color var(--quick) var(--ease);
  }

  a.outlet:hover,
  a.outlet:focus-visible {
    border-color: var(--brass);
    background: var(--teal-soft);
  }

  .outlet__name {
    font-weight: 600;
  }

  .outlet__date {
    grid-column: 1;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .outlet__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--brass-text);
    transition: transform var(--quick) var(--ease);
  }

  a.outlet:hover .outlet__arrow {
    transform: translate(2px, -2px);
  }

  .media__more {
    margin: var(--space-6) auto 0;
    max-width: 44rem;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .media-hero__inner {
      grid-template-columns: 1fr;
    }

    .media-hero__media {
      display: none;
    }

    .media-card {
      grid-template-columns: 1fr;
    }

    .media-card__where {
      padding: 1.1rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
