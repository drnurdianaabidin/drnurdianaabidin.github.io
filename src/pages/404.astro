---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { sections, sectionKeys } from '../lib/items';
---

<Base title="Page not found" noindex>
  <Masthead slot="header" />
  <div class="wrap missing">
    <p class="label">Page not found</p>
    <h1 class="missing__title">This page could not be found</h1>
    <p>It may have moved, or the address may have a small typing mistake. You could try one of these instead.</p>
    <ul>
      <li><a href="/">Home page</a></li>
      {sectionKeys.map((key) => <li><a href={`/${key}/`}>{sections[key].title}</a></li>)}
      <li><a href="/about/">About</a></li>
    </ul>
  </div>
</Base>

<style>
  .missing {
    text-align: center;
    padding-top: clamp(3rem, 8vw, 6rem);
    max-width: 40rem;
  }

  .missing__title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    margin: 0.75rem 0 1.25rem;
  }

  .missing ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }
</style>
