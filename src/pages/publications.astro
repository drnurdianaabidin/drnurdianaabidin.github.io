---
// Every publication from the Research section as a filterable set of cards.
// Accepted and under-review work, when there is any, is kept apart from
// published work.
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Illustration from '../components/Illustration.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { plain } from '../lib/placeholder.mjs';
import { settings, getPublications, publicationType, journalOf, authorsOf, type Item } from '../lib/items';

const publications = await getPublications();
const statusOf = (item: Item) => item.data.status ?? 'Published';
const published = publications.filter((p) => !['In press', 'Under review'].includes(statusOf(p)));
const inPress = publications.filter((p) => statusOf(p) === 'In press');
const underReview = publications.filter((p) => statusOf(p) === 'Under review');

const TYPES = ['Research article', 'Review', 'Book chapter'];
const typeCounts = new Map<string, number>();
for (const p of published) typeCounts.set(publicationType(p), (typeCounts.get(publicationType(p)) ?? 0) + 1);
const types = TYPES.filter((t) => typeCounts.has(t));
const years = [...new Set(published.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const searchText = (item: Item) =>
  plain([item.data.title, journalOf(item), authorsOf(item), item.data.summary].join(' ')).toLowerCase();

const scholar = settings.profiles.find((p) => /scholar/i.test(p.label) && p.url);
const orcid = settings.profiles.find((p) => /orcid/i.test(p.label) && p.url);
---

<Base
  title="Publications"
  description={`Journal articles and book chapters by ${settings.name} on sarcopenia, osteosarcopenic obesity, physical activity in older adults, exercise physiology and machine learning in healthcare, with DOI links.`}
>
  <Masthead slot="header" current="publications" />

  <header class="pubs-hero">
    <div class="wrap pubs-hero__inner">
      <div class="reveal">
        <p class="label">Research outputs</p>
        <h1 class="pubs-hero__title">Publications</h1>
        <p class="pubs-hero__desc">
          {published.length} published works, newest first. Filter by type or year, or search by topic, journal or author.
        </p>
        {
          (scholar || orcid) && (
            <p class="pubs-hero__links">
              Full record and citations:{' '}
              {scholar && (
                <a href={scholar.url} rel="noopener">
                  Google Scholar
                </a>
              )}
              {scholar && orcid && ' · '}
              {orcid && (
                <a href={orcid.url} rel="noopener">
                  ORCID
                </a>
              )}
            </p>
          )
        }
      </div>
      <div class="pubs-hero__media reveal reveal--right">
        <Illustration name="prediction" alt="" />
      </div>
    </div>
  </header>

  {
    inPress.length > 0 && (
      <section class="wrap pubs-section" aria-labelledby="in-press">
        <h2 id="in-press" class="pubs-section__title">Accepted and in press</h2>
        <div class="grid">
          {inPress.map((item) => (
            <PublicationCard item={item} />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap pubs-section" aria-labelledby="published">
    <h2 id="published" class="visually-hidden">Published work</h2>
    <div class="filters" data-filters hidden>
      <div class="filters__group" role="group" aria-labelledby="filter-type-label">
        <p class="label label--muted filters__label" id="filter-type-label">Type</p>
        <div class="filters__buttons">
          <button type="button" class="chip" data-filter="type" data-value="" aria-pressed="true">
            All <span class="chip__count">{published.length}</span>
          </button>
          {
            types.map((type) => (
              <button type="button" class="chip" data-filter="type" data-value={type} aria-pressed="false">
                {type} <span class="chip__count">{typeCounts.get(type)}</span>
              </button>
            ))
          }
        </div>
      </div>
      <div class="filters__group" role="group" aria-labelledby="filter-year-label">
        <p class="label label--muted filters__label" id="filter-year-label">Year</p>
        <div class="filters__buttons">
          <button type="button" class="chip" data-filter="year" data-value="" aria-pressed="true">All years</button>
          {
            years.map((year) => (
              <button type="button" class="chip" data-filter="year" data-value={String(year)} aria-pressed="false">
                {year}
              </button>
            ))
          }
        </div>
      </div>
      <div class="filters__search">
        <label class="label label--muted filters__label" for="search">Search</label>
        <input id="search" type="search" class="search" placeholder="Topic, journal or author" autocomplete="off" data-search />
      </div>
    </div>

    <p class="results label label--muted" aria-live="polite" data-results>{published.length} entries</p>

    <div class="grid grid--two" data-grid>
      {
        published.map((item, i) => (
          <div
            class="grid__item"
            data-card
            data-type={publicationType(item)}
            data-year={String(item.data.date.getUTCFullYear())}
            data-text={searchText(item)}
          >
            <PublicationCard item={item} delay={Math.min(i, 6) * 60} />
          </div>
        ))
      }
    </div>

    <div class="empty" data-empty hidden>
      <p>No publications match these filters.</p>
      <button type="button" class="chip" data-clear>Clear filters</button>
    </div>

    <p class="pubs-note">
      Conference presentations are listed in <a href={`/research/?type=${encodeURIComponent('Conference presentations')}`}>Research</a>,
      newspaper articles under <a href="/media/">Media</a>, and informal writing on the{' '}<a href="/blog/">Blog</a>. None of
      these are counted here.
    </p>
  </section>

  {
    underReview.length > 0 && (
      <section class="wrap pubs-section" aria-labelledby="under-review">
        <h2 id="under-review" class="pubs-section__title">Under review (not yet accepted)</h2>
        <div class="grid grid--two">
          {underReview.map((item) => (
            <PublicationCard item={item} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  import { initFilters } from '../scripts/filters';
  initFilters();
</script>

<style>
  .pubs-hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(800px 300px at 90% 0%, var(--violet-soft), transparent 70%),
      radial-gradient(700px 300px at 0% 100%, var(--teal-soft), transparent 70%);
    border-bottom: 1px solid var(--rule);
  }

  .pubs-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .pubs-hero__title {
    font-size: clamp(3.2rem, 6vw, 5.4rem);
    font-weight: 500;
    line-height: 1;
    margin: 0.6rem 0 1rem;
  }

  .pubs-hero__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1vw + 1rem, 1.6rem);
    line-height: 1.4;
    max-width: 34ch;
    color: var(--ink-soft);
  }

  .pubs-hero__links {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .pubs-hero__media {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .pubs-section {
    padding-top: var(--space-6);
  }

  .pubs-section__title {
    font-size: clamp(1.9rem, 2vw + 1.2rem, 2.6rem);
    margin-bottom: var(--space-4);
  }

  .grid--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pubs-note {
    margin: var(--space-5) 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .pubs-hero__inner {
      grid-template-columns: 1fr;
    }

    .pubs-hero__media {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .grid--two {
      grid-template-columns: 1fr;
    }
  }
</style>
