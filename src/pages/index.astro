---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Masthead from '../components/Masthead.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { settings, getFeatured, roman } from '../lib/items';
import { getSectionPanels, countLabel } from '../lib/home';

const panels = await getSectionPanels();
const featured = await getFeatured(6);
---

<Base>
  <Masthead size="large" slot="header" />

  <section class="wrap interests reveal" aria-label="Research interests">
    <p><T text={settings.interests} /></p>
  </section>

  <section class="wrap" aria-label="Sections of work">
    <ul class="panels">
      {
        panels.map((p) => (
          <li class="reveal" style={`--delay:${p.index * 120}ms`}>
            <a class="panel" href={`/${p.key}/`} data-panel>
              {p.image && (
                <div class="panel__media" aria-hidden="true">
                  <Image src={p.image} alt="" widths={[480, 760, 1100, 1500]} sizes="(min-width: 1240px) 600px, (min-width: 760px) 48vw, 94vw" format="webp" quality={76} loading="lazy" />
                </div>
              )}
              <div class="panel__body">
                <div class="panel__top">
                  <span class="panel__num">{roman(p.index)}</span>
                  <span class="panel__count label">{countLabel(p.count)}</span>
                </div>
                <div>
                  <h2 class="panel__title">{p.title}</h2>
                  <div class="panel__reveal">
                    <div>
                      <p class="panel__desc"><T text={p.description} /></p>
                      <p class="panel__cta label">Open {p.title}<span aria-hidden="true"> &rarr;</span></p>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {featured.length > 0 && <WorkIndex items={featured} heading="Selected work" headingId="selected-work" />}
</Base>

<script>
  // On touch screens the first tap reveals a panel and the second opens it.
  const canHover = window.matchMedia('(hover: hover)').matches;
  const panels = document.querySelectorAll<HTMLAnchorElement>('[data-panel]');
  if (!canHover) {
    panels.forEach((panel) => {
      panel.addEventListener('click', (event) => {
        if (!panel.classList.contains('is-open')) {
          event.preventDefault();
          panels.forEach((other) => other.classList.remove('is-open'));
          panel.classList.add('is-open');
        }
      });
    });
  }
</script>

<style>
  /* Interests line */
  .interests {
    text-align: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .interests p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 1.6vw + 0.9rem, 2rem);
    line-height: 1.35;
    color: var(--ink-soft);
    max-width: 34ch;
    margin: 0 auto;
  }

  /* Section panels */
  .panels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .panel {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9.5;
    overflow: hidden;
    isolation: isolate;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    transition: border-color var(--slow) var(--ease);
  }

  .panel::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid var(--rule);
    pointer-events: none;
    z-index: 1;
    transition: border-color var(--slow) var(--ease);
  }

  .panel__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity var(--slow) var(--ease), transform 1800ms var(--ease);
  }

  .panel__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(var(--scrim) / 0.86), rgb(var(--scrim) / 0.6) 70%);
  }

  .panel__body {
    position: absolute;
    inset: 0;
    padding: clamp(1.5rem, 3.2vw, 2.6rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .panel__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .panel__num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    color: var(--brass-text);
    transition: color var(--slow) var(--ease);
  }

  .panel__count {
    color: var(--muted);
    opacity: 0;
    transition: opacity var(--slow) var(--ease), color var(--slow) var(--ease);
  }

  .panel__title {
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    font-weight: 500;
    line-height: 1;
    transition: color var(--slow) var(--ease);
  }

  .panel__reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(8px);
    transition: grid-template-rows var(--slow) var(--ease), opacity var(--slow) var(--ease), transform var(--slow) var(--ease);
  }

  .panel__reveal > div {
    overflow: hidden;
  }

  .panel__desc {
    margin: 0.9rem 0 0.4rem;
    max-width: 38ch;
    font-size: 1rem;
    line-height: 1.5;
  }

  .panel__cta {
    margin: 0.6rem 0 0;
    color: inherit;
  }

  .panel:hover,
  .panel:focus-visible,
  .panel.is-open {
    border-color: transparent;
  }

  .panel:hover::before,
  .panel:focus-visible::before,
  .panel.is-open::before {
    border-color: rgb(246 241 231 / 0.35);
  }

  .panel:hover .panel__media,
  .panel:focus-visible .panel__media,
  .panel.is-open .panel__media {
    opacity: 1;
    transform: scale(1);
  }

  .panel:hover :is(.panel__title, .panel__num, .panel__count, .panel__desc, .panel__cta),
  .panel:focus-visible :is(.panel__title, .panel__num, .panel__count, .panel__desc, .panel__cta),
  .panel.is-open :is(.panel__title, .panel__num, .panel__count, .panel__desc, .panel__cta) {
    color: var(--on-image);
  }

  .panel:hover .panel__count,
  .panel:focus-visible .panel__count,
  .panel.is-open .panel__count {
    opacity: 1;
  }

  .panel:hover .panel__reveal,
  .panel:focus-visible .panel__reveal,
  .panel.is-open .panel__reveal {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: none;
  }

  .panel :global(mark.ph) {
    color: var(--ph-ink) !important;
  }

  @media (max-width: 760px) {
    .panels {
      grid-template-columns: 1fr;
    }

    .panel {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 560px) {
    .panel {
      aspect-ratio: 16 / 10;
    }
  }
</style>
