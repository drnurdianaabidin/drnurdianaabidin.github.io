---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Masthead from '../components/Masthead.astro';
import StructuredData from '../components/StructuredData.astro';
import Illustration from '../components/Illustration.astro';
import PublicationCard from '../components/PublicationCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getPosts } from '../lib/blog';
import {
  settings,
  sections,
  getItems,
  getPublications,
  getMedia,
  getInnovations,
  itemUrl,
  formatDate,
  sortedAppearances,
} from '../lib/items';

const about = await getEntry('about', 'index');
if (!about) throw new Error('The About page is missing. It should be at src/content/about/index.md');

const themes = sections.research.overview?.groups ?? [];
const features = sections.research.features.slice(0, 3);
const publications = await getPublications();
const latest = publications.slice(0, 3);
// The newest blog articles; the section is left out until there are any.
const posts = await getPosts();
const latestPosts = posts.slice(0, 3);
const article = (await getMedia()).find((item) => item.data.type === 'Newspaper articles');
const innovations = (await getInnovations()).sort(
  (a, b) => (a.data.innovation?.order ?? 99) - (b.data.innovation?.order ?? 99)
);
const highlights = settings.highlights.map((h) => ({
  ...h,
  value: h.value === 'auto' ? String(publications.length) : h.value,
}));
const explore = await Promise.all(
  (['academic', 'community', 'industry'] as const).map(async (key) => ({
    key,
    title: sections[key].title,
    description: sections[key].description,
    image: sections[key].image,
    count: (await getItems(key)).length,
  }))
);
---

<Base title={settings.siteTitle || undefined} titleIsFull>
  <Masthead slot="header" />
  <StructuredData slot="head" page="home" />

  <!-- Hero -->
  <section class="hero band" aria-labelledby="hero-title">
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    <div class="wrap hero__inner">
      <div class="hero__text">
        {settings.designation && <p class="label hero__kicker">{settings.designation}</p>}
        <h1 id="hero-title" class="hero__title">
          <span class="hero__name">{settings.name}</span>
          <span class="visually-hidden">: </span>
          {settings.headline && <span class="hero__headline">{settings.headline}</span>}
        </h1>
        <ul class="hero__tags" aria-label="Research areas">
          {settings.tagline.map((t) => <li>{t}</li>)}
        </ul>
        {settings.introduction && <p class="hero__intro"><T text={settings.introduction} /></p>}
        <div class="hero__actions">
          <a class="btn btn--primary" href="/research/">Explore the research <span class="btn__arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/publications/">Publications</a>
        </div>
      </div>
      <figure class="hero__portrait">
        <div class="hero__frame">
          <Image
            src={about.data.portrait}
            alt={about.data.portraitAlt}
            widths={[360, 540, 720]}
            sizes="(min-width: 980px) 360px, 60vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="hero__orbit" aria-hidden="true"></span>
      </figure>
    </div>
    <div class="wrap hero__foot">
      <a class="hero__scroll" href="#themes">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span>Scroll to explore</span>
      </a>
      <button class="hero__pause" type="button" aria-pressed="false" data-hero-pause hidden>
        <span class="hero__pause-icon" aria-hidden="true"></span>
        <span data-hero-pause-label>Pause background</span>
      </button>
    </div>
  </section>

  <!-- Research themes -->
  <section class="section" id="themes" aria-labelledby="themes-heading">
    <div class="wrap">
      <div class="heading-block reveal">
        <p class="label">Research themes</p>
        <h2 id="themes-heading">One question, five directions</h2>
        <p>
          How can musculoskeletal health, physical function and healthy ageing be better understood, assessed and improved? The
          research approaches it from five complementary directions.
        </p>
      </div>
      <ol class="themes">
        {
          themes.map((t, i) => (
            <li class="reveal" style={`--delay:${i * 90}ms`}>
              <article class="theme card card--link">
                <div class="theme__media zoom">
                  <Illustration name={t.image} />
                </div>
                <div class="theme__body">
                  <p class="label">Theme {i + 1}</p>
                  <h3 class="theme__title">
                    <a href={t.link || '/research/#overview'}>{t.title}</a>
                  </h3>
                  {t.intro && <p class="theme__intro">{t.intro}</p>}
                  <span class="theme__more" aria-hidden="true">
                    {t.linkLabel || 'Explore'} <span class="btn__arrow">→</span>
                  </span>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Current research -->
  <section class="section band current" aria-labelledby="current-heading">
    <div class="wrap">
      <div class="heading-block reveal">
        <p class="label">Current research</p>
        <h2 id="current-heading">Projects in progress</h2>
        <p>Each project is shown with its current stage. Ongoing work has not yet produced published results.</p>
      </div>
      <div class="current__grid">
        {
          features.map((f, i) => (
            <article class="current__card card card--link reveal" style={`--delay:${i * 110}ms`}>
              <div class="current__media zoom">
                <Illustration name={f.image} />
              </div>
              <div class="current__body">
                {f.status && <span class="badge">{f.status}</span>}
                <h3 class="current__title">
                  <a href={f.links[0]?.href ?? `/research/#${f.id}`}>{f.title}</a>
                </h3>
                <p class="current__kicker">{f.kicker}</p>
                <p class="current__text">{f.text}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="current__all reveal">
        <a class="btn btn--ghost" href="/research/#features">All research projects <span class="btn__arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- At a glance -->
  {
    highlights.length > 0 && (
      <section class="section section--tight glance" aria-labelledby="glance-heading">
        <div class="wrap">
          <h2 id="glance-heading" class="visually-hidden">At a glance</h2>
          <ul class="glance__list">
            {highlights.map((h, i) => (
              <li class="glance__item reveal" style={`--delay:${i * 90}ms`}>
                <span class="glance__value" data-count={/^\d+$/.test(h.value) ? h.value : undefined}>
                  {h.value}
                </span>
                <span class="glance__label">{h.label}</span>
                {h.detail && <span class="glance__detail">{h.detail}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Latest publications -->
  <section class="section section--sunk" aria-labelledby="pubs-heading">
    <div class="wrap">
      <div class="split-head reveal">
        <div class="heading-block">
          <p class="label">Publications</p>
          <h2 id="pubs-heading">Recent papers</h2>
        </div>
        <a class="btn btn--ghost" href="/publications/">All {publications.length} publications <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="pubs-grid">
        {latest.map((item, i) => <PublicationCard item={item} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <!-- Media and innovations -->
  <section class="section" aria-label="Media and innovations">
    <div class="wrap duo">
      {
        article && (
          <div class="duo__col reveal reveal--left">
            <div class="heading-block">
              <p class="label">In the media</p>
              <h2>Writing for the public</h2>
            </div>
            <article class="media-card card card--link">
              <span class="media-card__quote" aria-hidden="true">“</span>
              <p class="label label--muted">Opinion article</p>
              <h3 class="media-card__title">
                <a href={itemUrl(article)}>
                  <T text={article.data.title} />
                </a>
              </h3>
              <p class="media-card__summary">
                <T text={article.data.summary} />
              </p>
              <ul class="media-card__outlets" aria-label="Published in">
                {sortedAppearances(article)
                  .slice(0, 3)
                  .map((a) => (
                    <li>
                      <T text={a.outlet} />
                      {a.date && <span>{formatDate(a.date)}</span>}
                    </li>
                  ))}
              </ul>
            </article>
            <p class="duo__more">
              <a href="/media/">All media contributions →</a>
            </p>
          </div>
        )
      }
      <div class="duo__col reveal reveal--right">
        <div class="heading-block">
          <p class="label">Innovations</p>
          <h2>Tools from the research</h2>
        </div>
        <ul class="inno-list">
          {
            innovations.map((item) => (
              <li class="inno-row card card--link">
                <div class="inno-row__thumb zoom">
                  <Illustration name={item.data.innovation?.image || 'microneedle'} alt="" />
                </div>
                <div>
                  <a class="inno-row__title" href={itemUrl(item)}>
                    <T text={item.data.title} />
                  </a>
                  {item.data.status && <span class="inno-row__status">{item.data.status}</span>}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="duo__more">
          <a href="/innovations/">About the innovations →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Latest from the blog -->
  {
    latestPosts.length > 0 && (
      <section class="section section--sunk" aria-labelledby="blog-heading">
        <div class="wrap">
          <div class="split-head reveal">
            <div class="heading-block">
              <p class="label">Beyond the Lab</p>
              <h2 id="blog-heading">Latest From the Blog</h2>
            </div>
            <a class="btn btn--ghost" href="/blog/">
              {posts.length > latestPosts.length ? `All ${posts.length} articles` : 'Visit the blog'}
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="grid">
            {latestPosts.map((post, i) => (
              <BlogCard post={post} delay={i * 90} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Explore -->
  <section class="section section--tight" aria-labelledby="explore-heading">
    <div class="wrap">
      <div class="heading-block reveal">
        <p class="label">Explore</p>
        <h2 id="explore-heading">Teaching, community and industry</h2>
      </div>
      <ul class="explore">
        {
          explore.map((e, i) => (
            <li class="reveal" style={`--delay:${i * 90}ms`}>
              <article class="explore__card card card--link">
                <div class="explore__media zoom">
                  <Illustration name={e.image || 'community'} alt="" />
                </div>
                <div class="explore__body">
                  <p class="label label--muted">{e.count === 1 ? '1 entry' : `${e.count} entries`}</p>
                  <h3>
                    <a href={`/${e.key}/`}>{e.title}</a>
                  </h3>
                  <p>
                    <T text={e.description} />
                  </p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Collaboration -->
  <section class="section band collab" aria-labelledby="collab-heading">
    <div class="wrap collab__inner reveal">
      <p class="label">Collaboration</p>
      <h2 id="collab-heading" class="collab__title">Working together</h2>
      {settings.contactNote && <p class="collab__text"><T text={settings.contactNote} /></p>}
      <div class="hero__actions collab__actions">
        <a class="btn btn--primary" href={`mailto:${settings.email}`}>Email {settings.email}</a>
        <a class="btn btn--ghost" href="/contact/">Contact and profiles</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initHero } from '../scripts/hero';
  initHero();
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    min-height: min(100svh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Strongest on the right, faint behind the text */
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 15%) 0%, rgb(0 0 0 / 30%) 40%, #000 75%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3rem);
  }

  .hero__kicker {
    color: var(--night-accent);
    margin-bottom: 1.25rem;
  }

  .hero__title {
    display: grid;
    gap: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .hero__name {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1vw + 0.9rem, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--on-night);
  }

  .hero__headline {
    font-size: clamp(2.9rem, 5.6vw + 0.5rem, 5.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--on-night);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .hero__tags li {
    padding: 0.35rem 0.85rem;
    border: 1px solid rgb(143 216 211 / 35%);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--on-night);
    background: rgb(143 216 211 / 6%);
  }

  .hero__intro {
    max-width: 38rem;
    font-size: clamp(1.05rem, 0.4vw + 1rem, 1.2rem);
    color: var(--on-night-soft);
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Entrance: each part rises in turn when the page opens */
  .hero__text > *,
  .hero__portrait {
    animation: hero-rise 1100ms var(--ease-out) both;
  }

  .hero__text > :nth-child(2) {
    animation-delay: 120ms;
  }

  .hero__text > :nth-child(3) {
    animation-delay: 240ms;
  }

  .hero__text > :nth-child(4) {
    animation-delay: 360ms;
  }

  .hero__text > :nth-child(5) {
    animation-delay: 480ms;
  }

  .hero__portrait {
    animation-name: hero-portrait;
    animation-delay: 200ms;
    animation-duration: 1400ms;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes hero-portrait {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .hero__portrait {
    position: relative;
    margin: 0;
    justify-self: center;
    width: min(100%, 380px);
  }

  .hero__frame {
    position: relative;
    z-index: 1;
    border-radius: 999px 999px 28px 28px;
    overflow: hidden;
    border: 1px solid rgb(143 216 211 / 45%);
    box-shadow: 0 30px 80px rgb(0 0 0 / 35%);
    padding: 10px;
    background: rgb(234 241 248 / 6%);
  }

  .hero__frame :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 20px 20px;
  }

  /* A slow orbit ring behind the portrait */
  .hero__orbit {
    position: absolute;
    inset: -8% -10% auto -10%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed rgb(195 186 242 / 35%);
    animation: orbit 60s linear infinite;
  }

  .hero__orbit::before {
    content: '';
    position: absolute;
    top: 8%;
    left: 16%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--night-accent);
    box-shadow: 0 0 18px var(--night-accent);
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__foot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.75rem;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--on-night-soft);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__scroll:hover {
    color: var(--on-night);
  }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 46px;
    background: rgb(234 241 248 / 25%);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--night-accent);
    animation: scroll-cue 2.4s var(--ease) infinite;
  }

  @keyframes scroll-cue {
    to {
      top: 100%;
    }
  }

  .hero__pause {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 40px;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--night-rule);
    border-radius: 999px;
    background: rgb(11 26 46 / 50%);
    color: var(--on-night-soft);
    font-size: 0.78rem;
    cursor: pointer;
  }

  .hero__pause:hover {
    color: var(--on-night);
    border-color: rgb(234 241 248 / 40%);
  }

  .hero__pause-icon {
    width: 10px;
    height: 10px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }

  .hero__pause[aria-pressed='true'] .hero__pause-icon {
    border: 0;
    width: 0;
    height: 0;
    border-left: 9px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      grid-row: 1;
      width: min(62vw, 280px);
    }

    .hero__canvas {
      mask-image: none;
      opacity: 0.6;
    }
  }

  /* ---------- Research themes: an uneven grid of cards ---------- */
  .themes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .themes > li {
    grid-column: span 2;
  }

  .themes > li:nth-child(-n + 2) {
    grid-column: span 3;
  }

  .theme {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .theme__media {
    aspect-ratio: 16 / 9;
  }

  .themes > li:nth-child(-n + 2) .theme__media {
    aspect-ratio: 2 / 1;
  }

  .theme__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.35rem 1.5rem 1.5rem;
    flex: 1;
  }

  .theme__title {
    font-size: clamp(1.45rem, 0.8vw + 1.2rem, 1.85rem);
    font-weight: 600;
  }

  .theme__title a,
  .current__title a,
  .explore__card h3 a,
  .media-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Whole cards are clickable through their title link */
  .theme__title a::after,
  .current__title a::after,
  .explore__card h3 a::after,
  .media-card__title a::after,
  .inno-row__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .theme__intro {
    margin: 0;
    font-size: 0.98rem;
  }

  .theme__more {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brass-text);
  }

  .theme:hover .btn__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .themes > li,
    .themes > li:nth-child(-n + 2) {
      grid-column: span 1;
    }

    .themes > li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .themes {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Current research ---------- */
  .current__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .current__card {
    display: flex;
    flex-direction: column;
    background: rgb(234 241 248 / 4%);
    border-color: var(--night-rule);
    box-shadow: none;
  }

  .current__media {
    aspect-ratio: 3 / 2;
    border-bottom: 1px solid var(--night-rule);
  }

  .current__body {
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem 1.6rem;
    justify-items: start;
  }

  .current__title {
    font-size: 1.6rem;
    font-weight: 600;
  }

  .current__kicker {
    margin: 0;
    font-size: 0.85rem;
    color: var(--night-violet);
  }

  .current__text {
    margin: 0;
    font-size: 0.98rem;
  }

  .current__all {
    margin: 2.5rem 0 0;
  }

  @media (max-width: 980px) {
    .current__grid {
      grid-template-columns: 1fr;
    }

    .current__card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .current__media {
      aspect-ratio: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--night-rule);
    }
  }

  @media (max-width: 620px) {
    .current__card {
      grid-template-columns: 1fr;
    }

    .current__media {
      aspect-ratio: 3 / 2;
      border-right: 0;
      border-bottom: 1px solid var(--night-rule);
    }
  }

  /* ---------- At a glance ---------- */
  .glance__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .glance__item {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 0 0;
    border-top: 2px solid var(--brass);
  }

  .glance__value {
    font-family: var(--font-display);
    font-size: clamp(3rem, 4vw + 1rem, 4.4rem);
    font-weight: 500;
