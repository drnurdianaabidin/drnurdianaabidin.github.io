---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import WorkCard from '../../components/WorkCard.astro';
import T from '../../components/T.astro';
import Illustration from '../../components/Illustration.astro';
import CvLinks from '../../components/CvLinks.astro';
import Supervision from '../../components/Supervision.astro';
import { plain } from '../../lib/placeholder.mjs';
import { sections, sectionKeys, getItems, roman, inlineHtml, type SectionKey } from '../../lib/items';

export function getStaticPaths() {
  return sectionKeys.map((section) => ({ params: { section } }));
}

const key = Astro.params.section as SectionKey;
const section = sections[key];
const index = sectionKeys.indexOf(key);
const items = await getItems(key);
const overview = section.overview;
const numbered = (overview?.groups.filter((g) => g.title).length ?? 0) > 1;
// Themes with illustrations are shown as cards; plain lists otherwise.
const illustrated = overview?.groups.every((g) => g.image) ?? false;

// Only offer filters that would show something.
const typeCounts = new Map<string, number>();
for (const item of items) typeCounts.set(item.data.type, (typeCounts.get(item.data.type) ?? 0) + 1);
const types = section.categories.filter((c) => typeCounts.has(c));
const years = [...new Set(items.map((item) => item.data.date.getUTCFullYear()))].sort((a, b) => b - a);

const searchText = (item: (typeof items)[number]) => {
  const people = item.data.collaborators.map((c) =>
    typeof c === 'string' ? c : [c.name, c.role, c.affiliation].filter(Boolean).join(' ')
  );
  return plain([item.data.title, item.data.summary, item.data.type, ...people].join(' ')).toLowerCase();
};
---

<Base title={section.title} description={plain(section.description)}>
  <Masthead slot="header" current={key} />

  <header class:list={['section-hero', { 'section-hero--plain': !section.image }]}>
    <div class="wrap section-hero__inner">
      <div class="section-hero__text reveal">
        <p class="label">Section {roman(index)}</p>
        <h1 class="section-hero__title">{section.title}</h1>
        <p class="section-hero__desc"><T text={section.description} /></p>
        {key === 'academic' && <CvLinks class="section-hero__cv" />}
      </div>
      {
        section.image && (
          <div class="section-hero__media reveal reveal--right">
            <Illustration name={section.image} />
          </div>
        )
      }
    </div>
  </header>

  {/* The Academic page: postgraduate supervision and the invitation to prospective students */}
  {key === 'academic' && <Supervision />}

  {
    overview && (
      <section class="wrap overview" id="overview" aria-labelledby="overview-heading">
        <div class:list={['heading-block', { 'heading-block--centre': !illustrated }, 'reveal']}>
          <h2 id="overview-heading" class:list={[illustrated ? 'overview__heading' : 'label section-heading']}>{overview.heading}</h2>
          {overview.text && <p class="overview__text" set:html={inlineHtml(overview.text)} />}
        </div>
        {
          illustrated ? (
            <ol class="theme-grid">
              {overview.groups.map((g, i) => (
                <li class="reveal" style={`--delay:${i * 80}ms`}>
                  <article class="theme-card card" id={`theme-${i + 1}`}>
                    <div class="theme-card__media">
                      <Illustration name={g.image} />
                    </div>
                    <div class="theme-card__body">
                      <p class="label">Theme {i + 1}</p>
                      <h3 class="theme-card__title">{g.title}</h3>
                      {g.intro && <p class="theme-card__intro">{g.intro}</p>}
                      <details class="theme-card__areas">
                        <summary>
                          Areas of interest <span class="theme-card__count">{g.items.length}</span>
                        </summary>
                        <ul>
                          {g.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </details>
                      {g.link && (
                        <a class="theme-card__link" href={g.link}>
                          {g.linkLabel || 'Related work'} <span class="btn__arrow" aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          ) : (
            <ul class:list={['overview__groups', { 'overview__groups--single': overview.groups.length === 1 }]}>
              {overview.groups.map((g, i) => (
                <li class="overview__group reveal">
                  {g.title && (
                    <h3 class="overview__title">
                      {numbered && <span class="label overview__num">Theme {i + 1}</span>}
                      {g.title}
                    </h3>
                  )}
                  <ul class="overview__items">
                    {g.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          )
        }
        {overview.note && <p class="overview__note reveal" set:html={inlineHtml(overview.note)} />}
      </section>
    )
  }

  {
    section.features.length > 0 && (
      <section class="features" id="features" aria-labelledby="features-heading">
        <div class="wrap">
          <div class="heading-block reveal">
            <p class="label">In detail</p>
            <h2 id="features-heading">Research projects and programmes</h2>
            <p>The stage of each piece of work is shown. Ongoing projects have not yet produced published results.</p>
          </div>
          <ol class="feature-list">
            {section.features.map((f, i) => (
              <li id={f.id} class:list={['feature', { 'feature--flip': i % 2 === 1 }]}>
                <figure class:list={['feature__media', 'reveal', i % 2 === 1 ? 'reveal--right' : 'reveal--left']}>
                  <div class="feature__frame">
                    <Illustration name={f.image} />
                  </div>
                  <figcaption class="illus-note">Conceptual illustration</figcaption>
                </figure>
                <div class="feature__body reveal" style="--delay:120ms">
                  {f.kicker && <p class="label">{f.kicker}</p>}
                  <h3 class="feature__title">{f.title}</h3>
                  {f.status && <span class:list={['badge', { 'badge--violet': f.status === 'Published' }]}>{f.status}</span>}
                  <p class="feature__text">{f.text}</p>
                  {f.note && <p class="feature__note">{f.note}</p>}
                  {f.links.length > 0 && (
                    <p class="feature__links">
                      {f.links.map((l, k) => (
                        <a class:list={['btn', k === 0 ? 'btn--primary' : 'btn--ghost']} href={l.href}>
                          {l.label}
                          {k === 0 && (
                            <span class="btn__arrow" aria-hidden="true">
                              →
                            </span>
                          )}
                        </a>
                      ))}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="wrap outputs" aria-labelledby="outputs-heading">
    <div class="heading-block reveal">
      <p class="label">{section.title}</p>
      <h2 id="outputs-heading">{key === 'research' ? 'All research outputs' : `All ${section.title.toLowerCase()} work`}</h2>
    </div>
    {
      items.length > 0 ? (
        <>
          <div class="filters" data-filters hidden>
            <div class="filters__group" role="group" aria-labelledby="filter-type-label">
              <p class="label label--muted filters__label" id="filter-type-label">Type</p>
              <div class="filters__buttons">
                <button type="button" class="chip" data-filter="type" data-value="" aria-pressed="true">
                  All <span class="chip__count">{items.length}</span>
                </button>
                {types.map((type) => (
                  <button type="button" class="chip" data-filter="type" data-value={type} aria-pressed="false">
                    {type} <span class="chip__count">{typeCounts.get(type)}</span>
                  </button>
                ))}
              </div>
            </div>

            {years.length > 1 && (
              <div class="filters__group" role="group" aria-labelledby="filter-year-label">
                <p class="label label--muted filters__label" id="filter-year-label">Year</p>
                <div class="filters__buttons">
                  <button type="button" class="chip" data-filter="year" data-value="" aria-pressed="true">
                    All years
                  </button>
                  {years.map((year) => (
                    <button type="button" class="chip" data-filter="year" data-value={String(year)} aria-pressed="false">
                      {year}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <div class="filters__search">
              <label class="label label--muted filters__label" for="search">Search</label>
              <input id="search" type="search" class="search" placeholder={`Search ${section.title.toLowerCase()}`} autocomplete="off" data-search />
            </div>
          </div>

          <p class="results label label--muted" aria-live="polite" data-results>
            {items.length === 1 ? '1 entry' : `${items.length} entries`}
          </p>

          <div class="grid" data-grid>
            {items.map((item, i) => (
              <div
                class="grid__item"
                data-card
                data-type={item.data.type}
                data-year={String(item.data.date.getUTCFullYear())}
                data-text={searchText(item)}
              >
                <WorkCard item={item} level={3} showSection={false} delay={Math.min(i, 6) * 70} sizes="(min-width: 1240px) 380px, (min-width: 700px) 45vw, 92vw" />
              </div>
            ))}
          </div>

          <div class="empty" data-empty hidden>
            <p>No entries match these filters.</p>
            <button type="button" class="chip" data-clear>Clear filters</button>
          </div>
        </>
      ) : (
        <p class="empty">Work in this section will appear here soon.</p>
      )
    }
  </section>
</Base>

<script>
  import { initFilters } from '../../scripts/filters';
  initFilters();
</script>

<style>
  /* ---------- Header ---------- */
  .section-hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(800px 300px at 90% 0%, var(--teal-soft), transparent 70%),
      radial-gradient(700px 300px at 0% 100%, var(--violet-soft), transparent 70%);
    border-bottom: 1px solid var(--rule);
  }

  .section-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .section-hero--plain .section-hero__inner {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
  }

  .section-hero__title {
    font-size: clamp(3.2rem, 6vw, 5.4rem);
    font-weight: 500;
    line-height: 1;
    margin: 0.6rem 0 1rem;
  }

  .section-hero__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1vw + 1rem, 1.7rem);
    line-height: 1.4;
    max-width: 34ch;
    margin: 0;
    color: var(--ink-soft);
  }

  /* The CV buttons on the Academic page */
  .section-hero__text :global(.section-hero__cv) {
    margin-top: 1.75rem;
  }

  .section-hero__media {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  @media (max-width: 820px) {
    .section-hero__inner {
      grid-template-columns: 1fr;
    }

    .section-hero__media {
      aspect-ratio: 2 / 1;
    }
  }

  /* ---------- Overview ---------- */
  .overview {
    padding-block: var(--space-6);
  }

  .overview__heading {
    font-size: clamp(2.2rem, 3.4vw + 1rem, 3.4rem);
    margin-bottom: 0.9rem;
  }

  .overview__text {
    font-size: 1.08rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .overview__groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr));
    gap: var(--space-5) clamp(1.5rem, 3vw, 2.5rem);
  }

  .overview__groups--single {
    max-width: 46rem;
    margin: 0 auto;
  }

  .overview__title {
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .overview__num {
    display: block;
    margin-bottom: 0.45rem;
  }

  .overview__items {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .overview__items li::marker {
    color: var(--brass);
  }

  .overview__groups--single .overview__items {
    columns: 2 16rem;
    column-gap: 2.5rem;
    display: block;
  }

  .overview__groups--single .overview__items li {
    margin-bottom: 0.4rem;
    break-inside: avoid;
  }

  .overview__note {
    max-width: 46rem;
    margin: var(--space-5) auto 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* ---------- Theme cards ---------- */
  .theme-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .theme-grid > li {
    grid-column: span 2;
  }

  .theme-grid > li:nth-child(-n + 2) {
    grid-column: span 3;
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform var(--medium) var(--ease-out),
      box-shadow var(--medium) var(--ease-out);
  }

  .theme-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .theme-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .theme-card__media :global(.illus) {
    transition: transform 1200ms var(--ease-out);
  }

  .theme-card:hover .theme-card__media :global(.illus) {
    transform: scale(1.045);
  }

  .theme-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.35rem 1.5rem 1.5rem;
    flex: 1;
  }

  .theme-card__title {
    font-size: clamp(1.45rem, 0.8vw + 1.2rem, 1.8rem);
    font-weight: 600;
  }

  .theme-card__intro {
    margin: 0;
    font-size: 0.98rem;
  }

  .theme-card__areas {
    border-top: 1px solid var(--rule);
    padding-top: 0.6rem;
    font-size: 0.92rem;
  }

  .theme-card__areas summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--ink);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
  }

  .theme-card__areas summary::-webkit-details-marker {
    display: none;
  }

  .theme-card__areas summary::after {
    content: '+';
    margin-left: auto;
    font-size: 1.2rem;
    color: var(--brass-text);
    transition: transform var(--quick) var(--ease);
  }

  .theme-card__areas[open] summary::after {
    transform: rotate(45deg);
  }

  .theme-card__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--teal-soft);
    color: var(--brass-text);
    font-size: 0.75rem;
  }

  .theme-card__areas ul {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.25rem;
    color: var(--ink-soft);
    animation: areas-open var(--medium) var(--ease-out);
  }

  .theme-card__areas li::marker {
    color: var(--brass);
  }

  @keyframes areas-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .theme-card__link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brass-text);
    text-decoration: none;
  }

  .theme-card__link:hover .btn__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    .theme-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-grid > li,
    .theme-grid > li:nth-child(-n + 2) {
      grid-column: span 1;
    }

    .theme-grid > li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .theme-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Feature panels ---------- */
  .features {
    padding-block: var(--space-7);
    background: var(--paper-sunk);
    border-block: 1px solid var(--rule);
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .feature--flip .feature__media {
    order: 2;
  }

  .feature__media {
    margin: 0;
  }

  .feature__frame {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .feature__body {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .feature__title {
    font-size: clamp(2rem, 2.2vw + 1.2rem, 2.9rem);
    font-weight: 500;
  }

  .feature__text {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
  }

  .feature__note {
    margin: 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--violet);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature--flip .feature__media {
      order: 0;
    }
  }

  /* ---------- All outputs ---------- */
  .outputs {
    padding-top: var(--space-6);
  }

</style>
