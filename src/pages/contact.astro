---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import T from '../components/T.astro';
import { plain } from '../lib/placeholder.mjs';
import { settings } from '../lib/items';

const email = plain(settings.email);
---

<Base title="Contact" description={`How to contact ${settings.name}.`}>
  <Masthead slot="header" current="contact" />

  <div class="wrap contact">
    <header class="contact__head reveal">
      <p class="label">Contact</p>
      <h1 class="contact__title">Correspondence</h1>
    </header>

    <div class="contact__body reveal">
      {settings.contactNote && <p class="contact__note"><T text={settings.contactNote} /></p>}
      <p class="contact__email">
        <a href={`mailto:${email}`}><T text={settings.email} /></a>
      </p>
      <hr class="rule contact__rule" />
      <p class="contact__affil">
        {settings.affiliations.map((a) => <span>{a}</span>)}
        <span>{settings.institution}</span>
      </p>
    </div>
  </div>
</Base>

<style>
  .contact__head {
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .contact__title {
    font-size: clamp(2.8rem, 5.5vw, 4.6rem);
    font-weight: 500;
    margin-top: 0.6rem;
  }

  .contact__body {
    max-width: 44rem;
    margin: 0 auto;
    text-align: center;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
  }

  .contact__note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1vw + 1rem, 1.6rem);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 34ch;
    margin: 0 auto 2rem;
  }

  .contact__email {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.8rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .contact__email a {
    color: var(--ink);
    text-decoration-color: var(--brass);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact__rule {
    width: 4rem;
    margin: 2.5rem auto;
    border-top-color: var(--brass);
  }

  .contact__affil {
    display: grid;
    gap: 0.2rem;
    color: var(--muted);
  }
</style>
