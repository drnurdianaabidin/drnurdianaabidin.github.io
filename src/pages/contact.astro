---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import T from '../components/T.astro';
import Profiles from '../components/Profiles.astro';
import { plain } from '../lib/placeholder.mjs';
import { settings } from '../lib/items';

const email = plain(settings.email);
---

<Base title="Contact" description={`Contact ${settings.name} about research collaboration, postgraduate study and partnerships. Email and academic profiles.`}>
  <Masthead slot="header" current="contact" />

  <header class="contact-hero band">
    <div class="wrap contact-hero__inner reveal">
      <p class="label">Contact</p>
      <h1 class="contact-hero__title">Let’s work together</h1>
      {settings.contactNote && <p class="contact-hero__note"><T text={settings.contactNote} /></p>}
      {
        settings.tagline.length > 0 && (
          <ul class="contact-hero__areas" aria-label="Research areas">
            {settings.tagline.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  <div class="wrap contact">
    <section class="card contact__card contact__card--email reveal" aria-labelledby="email-heading">
      <h2 id="email-heading" class="label">Email</h2>
      <p class="contact__email">
        <a href={`mailto:${email}`}><T text={settings.email} /></a>
      </p>
      <p class="contact__hint">For research collaboration, postgraduate supervision, invited talks and media enquiries.</p>
      <a class="btn btn--primary" href={`mailto:${email}`}>
        Write an email<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </section>

    {
      settings.profiles.length > 0 && (
        <section class="card contact__card reveal" style="--delay:100ms" aria-labelledby="profiles-heading">
          <h2 id="profiles-heading" class="label">Academic profiles</h2>
          <Profiles />
        </section>
      )
    }

    <section class="card contact__card reveal" style="--delay:200ms" aria-labelledby="affil-heading">
      <h2 id="affil-heading" class="label">Affiliation</h2>
      <p class="contact__affil">
        {settings.affiliations.map((a) => <span>{a}</span>)}
        <span>{settings.institution}</span>
      </p>
      <p class="contact__more"><a href="/about/">Biography and career</a></p>
    </section>
  </div>
</Base>

<style>
  .contact-hero {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(5rem, 9vw, 7rem);
  }

  .contact-hero__inner {
    text-align: center;
  }

  .contact-hero__title {
    font-size: clamp(2.8rem, 5.5vw, 4.6rem);
    font-weight: 500;
    margin: 0.6rem 0 1rem;
  }

  .contact-hero__note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1vw + 1rem, 1.55rem);
    line-height: 1.45;
    max-width: 44ch;
    margin: 0 auto;
  }

  .contact-hero__areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .contact-hero__areas li {
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(143 216 211 / 35%);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--on-night);
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: calc(-1 * clamp(3rem, 6vw, 4rem));
    position: relative;
  }

  .contact__card {
    padding: clamp(1.5rem, 3vw, 2.1rem);
  }

  .contact__card h2 {
    margin: 0 0 1rem;
  }

  .contact__email {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.6vw + 0.9rem, 2rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    margin: 0 0 0.75rem;
  }

  .contact__email a {
    color: var(--ink);
    text-decoration-color: var(--brass);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact__hint {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1.4rem;
  }

  .contact__affil {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .contact__more {
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .contact {
      grid-template-columns: 1fr 1fr;
    }

    .contact__card--email {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
