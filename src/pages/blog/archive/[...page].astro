---
// Every article, newest first, grouped by year. Long archives are split over
// several pages: /blog/archive/, /blog/archive/2/ and so on.
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../../layouts/Base.astro';
import Masthead from '../../../components/Masthead.astro';
import T from '../../../components/T.astro';
import { formatDate, isoDate } from '../../../lib/items';
import { blog, getPosts, postUrl, topicOf, topicUrl, readingTime, type Post } from '../../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: blog.archivePageSize, props: { total: posts.length } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  total: number;
}

const { page, total } = Astro.props;
const years = [...new Set(page.data.map((p) => p.data.date.getUTCFullYear()))];
const dayMonth = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

<Base
  title={page.currentPage > 1 ? `Archive, page ${page.currentPage}: ${blog.title}` : `Archive: ${blog.title}`}
  description={`Every article from ${blog.title}, the blog of Dr Nurdiana Zainol Abidin, by year.`}
  noindex={total === 0}
>
  <Masthead slot="header" current="blog" />

  <header class="wrap archive-head reveal">
    <p class="archive-head__crumbs label">
      <a href="/blog/">{blog.title}</a>
      <span aria-hidden="true">/</span> Archive
    </p>
    <h1 class="archive-head__title">All articles</h1>
    <p class="archive-head__desc">
      {
        total === 0
          ? 'No articles have been published yet.'
          : `${total === 1 ? '1 article' : `${total} articles`}, newest first${page.lastPage > 1 ? ` (page ${page.currentPage} of ${page.lastPage})` : ''}.`
      }
    </p>
  </header>

  <div class="wrap archive">
    {
      years.map((year) => (
        <section class="archive__year reveal" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="archive__year-title">
            {year}
          </h2>
          <ol class="archive__list">
            {page.data
              .filter((p) => p.data.date.getUTCFullYear() === year)
              .map((post) => {
                const topic = topicOf(post.data.category);
                return (
                  <li class="archive__item" data-topic-colour={topic.colour}>
                    <time class="archive__date" datetime={isoDate(post.data.date)} title={formatDate(post.data.date)}>
                      {dayMonth(post.data.date)}
                    </time>
                    <div>
                      <a class="archive__title" href={postUrl(post)}>
                        <T text={post.data.title} />
                      </a>
                      <p class="archive__meta">
                        <a href={topicUrl(topic.name)}>
                          <span class="topic-dot" aria-hidden="true" />
                          {topic.name}
                        </a>
                        <span>{readingTime(post)} min read</span>
                        {post.data.draft && <span class="archive__draft">Draft</span>}
                      </p>
                    </div>
                  </li>
                );
              })}
          </ol>
        </section>
      ))
    }

    {
      page.lastPage > 1 && (
        <nav class="archive__pages" aria-label="Archive pages">
          {page.url.prev ? (
            <a class="chip" href={page.url.prev} rel="prev">
              ← Newer
            </a>
          ) : (
            <span />
          )}
          <span class="label label--muted">
            Page {page.currentPage} of {page.lastPage}
          </span>
          {page.url.next ? (
            <a class="chip" href={page.url.next} rel="next">
              Older →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <p class="archive__back"><a href="/blog/">← Back to {blog.title}</a></p>
  </div>
</Base>

<style>
  .archive-head {
    max-width: 52rem;
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: var(--space-5);
  }

  .archive-head__crumbs {
    display: flex;
    gap: 0.6rem;
    margin: 0 0 1rem;
  }

  .archive-head__crumbs a {
    color: var(--brass-text);
    text-decoration: none;
  }

  .archive-head__title {
    font-size: clamp(2.6rem, 4.5vw + 0.5rem, 4.4rem);
    font-weight: 500;
  }

  .archive-head__desc {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .archive {
    max-width: 52rem;
  }

  .archive__year + .archive__year {
    margin-top: var(--space-5);
  }

  .archive__year-title {
    font-size: 2rem;
    padding-bottom: 0.5rem;
    margin: 0 0 0.5rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .archive__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .archive__date {
    padding-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .archive__title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
  }

  .archive__title:hover {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .archive__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .archive__meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--topic);
    font-weight: 600;
    text-decoration: none;
  }

  .archive__draft {
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--ph-bg);
    color: var(--ph-ink);
  }

  .archive__pages {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-5);
  }

  .archive__pages .chip {
    text-decoration: none;
    justify-self: start;
  }

  .archive__pages .chip[rel='next'] {
    justify-self: end;
  }

  .archive__back {
    margin: var(--space-5) 0 0;
    font-weight: 600;
  }
</style>
