---
import T from './T.astro';
import { plain } from '../lib/placeholder.mjs';
import { settings, sections, sectionKeys, extraPages } from '../lib/items';
const year = new Date().getFullYear();
---

<footer class="site-footer band">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__name">{settings.name}</p>
        <p class="site-footer__tagline">{settings.tagline.join(' · ')}</p>
        <p class="site-footer__affil">
          {settings.affiliations.map((a) => <span>{a}</span>)}
          <span>{settings.institution}</span>
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="label">Explore</p>
        <ul>
          {sectionKeys.map((key) => <li><a href={`/${key}/`}>{sections[key].title}</a></li>)}
          {extraPages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="label">Contact</p>
        <ul>
          <li><a href={`mailto:${plain(settings.email)}`}><T text={settings.email} /></a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Collaboration</a></li>
          {settings.profiles.filter((p) => p.url).map((p) => <li><a href={p.url} rel="noopener">{p.label}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="site-footer__small">
      &copy; {year} {settings.name}. Illustrations on this site are conceptual drawings, not photographs or research data.
      {settings.goatcounter && ' Visits are counted anonymously, without cookies.'}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding: var(--space-6) 0 var(--space-5);
    font-size: 0.95rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--night-rule);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--on-night);
    margin-bottom: 0.4rem;
  }

  .site-footer__tagline {
    color: var(--night-accent);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .site-footer__affil {
    display: grid;
    gap: 0.15rem;
    color: var(--on-night-soft);
    margin: 0;
  }

  .site-footer .label {
    margin-bottom: 0.9rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .site-footer a {
    color: var(--on-night-soft);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--on-night);
    text-decoration: underline;
    text-decoration-color: var(--night-accent);
  }

  .site-footer__small {
    margin: var(--space-4) 0 0;
    font-size: 0.82rem;
    color: #8fa1b8;
  }

  @media (max-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }
  }
</style>
