---
// The academic profile links from src/settings.yaml (ORCID, Google Scholar
// and so on), shown on the About and Contact pages.
import { settings } from '../lib/items';

interface Props {
  align?: 'left' | 'centre';
}

const { align = 'left' } = Astro.props;
---

{
  settings.profiles.length > 0 && (
    <ul class:list={['profiles', `profiles--${align}`]}>
      {settings.profiles.map((p) => (
        <li>
          {p.url ? (
            <a href={p.url} rel="noopener">
              {p.label}
              <span class="profiles__arrow" aria-hidden="true"> ↗</span>
            </a>
          ) : (
            <span class="profiles__label">{p.label}</span>
          )}
          {p.value && <span class="profiles__value">{p.value}</span>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .profiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .profiles--centre {
    justify-items: center;
    text-align: center;
  }

  .profiles li {
    display: grid;
    gap: 0.1rem;
  }

  .profiles a,
  .profiles__label {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .profiles a {
    text-decoration-color: var(--brass);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .profiles__arrow {
    color: var(--brass-text);
    font-size: 0.9em;
  }

  .profiles__value {
    font-size: 0.92rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
