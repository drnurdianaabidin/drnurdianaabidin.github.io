---
import { Image } from 'astro:assets';
import T from './T.astro';
import { plain } from '../lib/placeholder.mjs';
import { type Item, sections, itemUrl, formatDate, isoDate } from '../lib/items';

interface Props {
  item: Item;
  showSection?: boolean;
  showSummary?: boolean;
  sizes?: string;
  delay?: number;
  level?: 2 | 3;
}

const {
  item,
  showSection = true,
  showSummary = true,
  sizes = '(min-width: 1240px) 280px, (min-width: 640px) 45vw, 92vw',
  delay = 0,
  level = 3,
} = Astro.props;
const { data } = item;
const Heading = level === 2 ? 'h2' : 'h3';
// A DOI link (a paper, chapter or abstract) is also offered on the card itself.
const doiLink = data.links.find((link) => /^https?:\/\/(dx\.)?doi\.org\//i.test(link.url));
---

<article class="card card--link work-card reveal" style={`--delay:${delay}ms`}>
  <div class="work-card__media zoom">
    <Image src={data.cover} alt="" widths={[360, 560, 800, 1100]} sizes={sizes} format="webp" quality={78} />
  </div>
  <div class="work-card__body">
    <p class="label work-card__meta">
      {showSection && <span>{sections[item.collection].title}<span class="visually-hidden">,</span></span>}
      <span class="work-card__type">{data.type}</span>
    </p>
    <Heading class="work-card__title">
      <a class="work-card__link" href={itemUrl(item)}><T text={data.title} /></a>
    </Heading>
    <p class="work-card__date">
      <time datetime={isoDate(data.date)}>{formatDate(data.date, 'month')}</time>
      {data.status && <span class="work-card__status">{data.status}</span>}
    </p>
    {showSummary && <p class="work-card__summary"><T text={data.summary} /></p>}
    {
      doiLink && (
        <a class="work-card__doi" href={doiLink.url} rel="noopener">
          <T text={doiLink.label} />
          <span class="visually-hidden">: {plain(data.title)}</span>
          <span aria-hidden="true"> ↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .work-card__media {
    aspect-ratio: 3 / 2;
    background: var(--paper-sunk);
  }

  .work-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.2rem 1.35rem 1.35rem;
    flex: 1;
  }

  .work-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
    margin: 0;
  }

  .work-card__type {
    color: var(--muted);
  }

  .work-card__title {
    font-size: clamp(1.3rem, 0.6vw + 1.12rem, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
  }

  /* The whole card opens the page */
  .work-card__link {
    color: var(--ink);
    text-decoration: none;
  }

  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-card:hover .work-card__link {
    color: var(--link);
  }

  .work-card__date {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .work-card__status {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--teal-soft);
    color: var(--brass-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .work-card__summary {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .work-card__doi {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brass-text);
    text-decoration: none;
  }

  .work-card__doi:hover {
    text-decoration: underline;
  }
</style>
