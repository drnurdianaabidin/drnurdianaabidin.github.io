---
const { class: className = '' } = Astro.props;
---

<button type="button" class:list={['theme-toggle', className]} data-theme-toggle aria-label="Switch colour mode">
  <span class="theme-toggle__mark" aria-hidden="true"></span>
  <span class="theme-toggle__text"><span data-theme-label>Dark</span> mode</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: 0;
    padding: 0.5rem 0;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-night-soft);
    transition: color var(--quick) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--on-night);
  }

  .theme-toggle__text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .theme-toggle {
    justify-content: center;
    min-width: 44px;
    border-radius: 50%;
  }

  .theme-toggle__mark {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
</style>
